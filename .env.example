# ---------------------------------------------------------------------------
# rás -- connection secrets and machine-specific paths.
#
# Copy this file to `.env` and fill it in. Everything that is *behaviour*
# (quality profiles, intervals, thresholds) lives in config/conduit.toml and is
# editable from the dashboard -- only credentials and paths belong here.
# ---------------------------------------------------------------------------

# --- Plex -------------------------------------------------------------------
# Local server URL and your account token.
# Token guide: https://support.plex.tv/articles/204059436
PLEX_URL=http://localhost:32400
PLEX_TOKEN=

# --- TMDB -------------------------------------------------------------------
# https://developer.themoviedb.org/docs/getting-started
TMDB_API_KEY=

# --- Trackers ---------------------------------------------------------------
# Any UNIT3D-based tracker works. Add more in config/conduit.toml and point
# each one at its own env var here.
AITHER_API_KEY=

# --- qBittorrent ------------------------------------------------------------
QBITTORRENT_URL=http://localhost:8080
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=

# --- Storage ----------------------------------------------------------------
# Comma-separated list of download roots, tried in order of most free space.
DOWNLOAD_DIRS=D:\Torrents,E:\Torrent

# --- Web server -------------------------------------------------------------
CONDUIT_HOST=0.0.0.0
CONDUIT_PORT=5050
# Access control: "lan" (private IP ranges only), "token", "both", or "none".
CONDUIT_AUTH_MODE=lan
# Required when auth mode includes "token". Sent as `X-rás-Token` or ?token=
CONDUIT_API_TOKEN=

# --- Diagnostics ------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
CONDUIT_LOG_LEVEL=INFO
